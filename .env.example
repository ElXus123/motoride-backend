# ── Front (Vite) ──────────────────────────────────────────────
# Servidor Socket.IO (Render). Obligatorio: Cloudflare Workers solo sirve estáticos.
VITE_SOCKET_URL="https://motoride-socket.onrender.com"

# Opcional: servidores ICE extra fijos (JSON array). Lo normal es dar TURN desde el backend (ver abajo).
# Ejemplo: [{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
VITE_WEBRTC_ICE_SERVERS=""

# Opcional: otro proveedor de teselas del mapa (plantilla Leaflet). Por defecto Esri World Street Map.
# Ejemplo Carto con clave: https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?api_key=TU_CLAVE
VITE_MAP_TILE_URL=""

# ── Backend (server.ts en Render) ─────────────────────────────
# Obligatorio en producción: JSON de la cuenta de servicio de Firebase (Firebase Console > Configuración >
# Cuentas de servicio > Generar nueva clave privada), pegado como texto en una sola línea. Sin esto el
# servidor rechaza todas las conexiones. NO poner la clave en el repositorio.
# FIREBASE_SERVICE_ACCOUNT_JSON=""
# Opcional. Por defecto: https://motobike.juarp123.workers.dev (+ localhost si NODE_ENV no es production).
# CORS_ORIGIN="https://motobike.juarp123.workers.dev"
# NODE_ENV=production
# TURN para la voz con datos móviles (Cloudflare Realtime → TURN, gratis hasta 1 TB/mes):
# CLOUDFLARE_TURN_KEY_ID=""
# CLOUDFLARE_TURN_KEY_API_TOKEN=""
# Alternativa: ICE_SERVERS_JSON='[{"urls":"turn:...","username":"...","credential":"..."}]'
