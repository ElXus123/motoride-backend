rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - displayName: string (required, 1-50 chars)
    //   - photoURL: string (optional, URL or Base64)
    //   - points: number (optional, positive)
    //   - level: number (optional, positive)
    //   - totalDistance: number (optional, positive)
    //   - totalLeftTurns: number (optional, positive)
    //   - totalRightTurns: number (optional, positive)
    //
    // Collection: groups
    // Document ID: {groupId} (6-char code)
    // Fields:
    //   - name: string (required, 1-100 chars)
    //   - code: string (required, 6 chars)
    //   - createdBy: string (required, UID)
    //   - members: list (required, UIDs)
    //   - routeGeoJSON: string (optional)
    //   - isScheduled: bool (required)
    //   - scheduledTimestamp: number (required)
    //   - province: string (optional)
    //   - municipality: string (optional)
    //   - description: string (optional)
    //   - isEsporadica: bool (optional)
    //   - isRecording: bool (optional)
    //   - startTime: number (optional)
    //   - createdAt: number (required)
    //
    // Collection: locations
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required, UID)
    //   - lat: number (required)
    //   - lng: number (required)
    //   - speed: number (optional)
    //   - heading: number (optional)
    //   - score: number (optional)
    //   - timestamp: number (required)
    //   - photoURL: string (optional)
    //   - displayName: string (optional)
    //   - alert: map (optional) { type: string, timestamp: number }
    //
    // Collection: rideHistory
    // Document ID: {rideId}
    // Fields:
    //   - uid: string (required, UID)
    //   - groupId: string (required)
    //   - groupName: string (optional)
    //   - startTime: number (required)
    //   - endTime: number (required)
    //   - distance: number (required, positive)
    //   - maxLeanLeft: number (optional)
    //   - maxLeanRight: number (optional)
    //   - leftTurns: number (optional)
    //   - rightTurns: number (optional)
    //   - score: number (optional)
    //   - path: list (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidString(field, min, max) {
      return request.resource.data[field] is string && 
             request.resource.data[field].size() >= min && 
             request.resource.data[field].size() <= max;
    }

    function isValidOptionalString(field, max) {
      return !(field in request.resource.data) || 
             (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    function isValidNumber(field) {
      return request.resource.data[field] is number;
    }

    function isValidOptionalNumber(field) {
      return !(field in request.resource.data) || request.resource.data[field] is number;
    }

    function isRecent(field) {
      return request.resource.data[field] is number && 
             request.resource.data[field] > (request.time.toMillis() - 3600000) &&
             request.resource.data[field] < (request.time.toMillis() + 3600000);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return hasRequiredFields(['displayName']) &&
             isValidString('displayName', 1, 50) &&
             isValidOptionalString('photoURL', 200000) && // Allow Base64
             isValidOptionalNumber('points') &&
             isValidOptionalNumber('level') &&
             isValidOptionalNumber('totalDistance') &&
             isValidOptionalNumber('totalLeftTurns') &&
             isValidOptionalNumber('totalRightTurns');
    }

    function isValidGroup(data) {
      return hasRequiredFields(['name', 'code', 'createdBy', 'members', 'isScheduled', 'scheduledTimestamp', 'createdAt']) &&
             isValidString('name', 1, 100) &&
             isValidString('code', 6, 6) &&
             data.createdBy == request.auth.uid &&
             data.members is list &&
             data.members.size() <= 100 &&
             isValidNumber('scheduledTimestamp') &&
             isValidNumber('createdAt') &&
             isValidOptionalString('routeGeoJSON', 1000000) &&
             isValidOptionalString('province', 50) &&
             isValidOptionalString('municipality', 50) &&
             isValidOptionalString('description', 500) &&
             (!('isRecording' in data) || data.isRecording is bool) &&
             isValidOptionalNumber('startTime');
    }

    function isValidLocation(data) {
      return hasRequiredFields(['uid', 'lat', 'lng', 'timestamp']) &&
             data.uid == request.auth.uid &&
             isValidNumber('lat') &&
             isValidNumber('lng') &&
             isValidNumber('timestamp') &&
             isValidOptionalNumber('speed') &&
             isValidOptionalNumber('heading') &&
             isValidOptionalNumber('score') &&
             isValidOptionalString('photoURL', 200000) &&
             isValidOptionalString('displayName', 50) &&
             (!('alert' in data) || data.alert is map);
    }

    function isValidRideHistory(data) {
      return hasRequiredFields(['uid', 'groupId', 'startTime', 'endTime', 'distance']) &&
             data.uid == request.auth.uid &&
             isValidNumber('startTime') &&
             isValidNumber('endTime') &&
             isValidNumber('distance') &&
             request.resource.data.distance >= 0 &&
             isValidOptionalNumber('maxLeanLeft') &&
             isValidOptionalNumber('maxLeanRight') &&
             isValidOptionalNumber('leftTurns') &&
             isValidOptionalNumber('rightTurns') &&
             isValidOptionalNumber('score') &&
             (!( 'path' in data) || data.path is list);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
    }

    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidGroup(request.resource.data);
      allow update: if isAuthenticated() && (
        // Creator can update everything
        (resource.data.createdBy == request.auth.uid && isValidGroup(request.resource.data)) ||
        // Members can join (only 'members' field changes)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) && 
         request.resource.data.members.size() > resource.data.members.size() &&
         request.resource.data.members.hasAll(resource.data.members) &&
         request.auth.uid in request.resource.data.members)
      );
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    match /locations/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidLocation(request.resource.data);
      allow update: if isOwner(userId) && isValidLocation(request.resource.data);
    }

    match /rideHistory/{rideId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && isValidRideHistory(request.resource.data);
      allow update: if false; // Ride history is immutable
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
  }
}
