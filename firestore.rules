rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == "juarp123@gmail.com";
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidString(field, min, max) {
      return request.resource.data[field] is string &&
             request.resource.data[field].size() >= min &&
             request.resource.data[field].size() <= max;
    }

    function isValidOptionalString(field, max) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    function isValidNumber(field) {
      return request.resource.data[field] is number;
    }

    function isValidOptionalNumber(field) {
      return !(field in request.resource.data) || request.resource.data[field] is number;
    }

    function isValidOptionalBool(field) {
      return !(field in request.resource.data) || request.resource.data[field] is bool;
    }

    /** Invitaciones: el SDK puede guardar millis como int o number; Timestamp si hubo migración. */
    function validRideInviteSentAt(t) {
      return t is number || t is int || t is timestamp;
    }

    function isValidUser(data) {
      return hasRequiredFields(['displayName']) &&
             isValidString('displayName', 1, 50) &&
             isValidOptionalString('displayNameLower', 50) &&
             isValidOptionalString('photoURL', 200000) &&
             isValidOptionalNumber('points') &&
             isValidOptionalNumber('level') &&
             isValidOptionalNumber('totalDistance') &&
             isValidOptionalNumber('totalLeftTurns') &&
             isValidOptionalNumber('totalRightTurns') &&
             (!('friends' in data) || data.friends is list) &&
             (!('friendRequestsIncoming' in data) || data.friendRequestsIncoming is list) &&
             (!('friendRequestsOutgoing' in data) || data.friendRequestsOutgoing is list) &&
             isValidOptionalBool('isPremium') &&
             isValidOptionalString('motorcycle', 120) &&
             (!('rideInvitePending' in data) || data.rideInvitePending == null ||
               (data.rideInvitePending is map &&
                data.rideInvitePending.keys().hasAll(['fromUid','groupId','groupName','sentAt']) &&
                data.rideInvitePending.fromUid is string &&
                data.rideInvitePending.groupId is string &&
                data.rideInvitePending.groupId.size() == 6 &&
                data.rideInvitePending.groupName is string &&
                data.rideInvitePending.groupName.size() <= 120 &&
                validRideInviteSentAt(data.rideInvitePending.sentAt)));
    }

    function isOptionalRouteGeoJSON(data) {
      return !('routeGeoJSON' in data) ||
             data.routeGeoJSON == null ||
             (data.routeGeoJSON is string && data.routeGeoJSON.size() <= 1000000);
    }

    function isValidRouteListing(data) {
      return !('routeListing' in data) ||
        (data.routeListing is string &&
          (data.routeListing == 'public' ||
            data.routeListing == 'friends_only' ||
            data.routeListing == 'unlisted'));
    }

    function isValidGroup(data) {
      return hasRequiredFields(['name', 'code', 'createdBy', 'members', 'isScheduled', 'scheduledTimestamp', 'createdAt']) &&
             isValidString('name', 1, 100) &&
             isValidString('code', 6, 6) &&
             data.createdBy == request.auth.uid &&
             data.members is list &&
             data.members.size() <= 100 &&
             isValidNumber('scheduledTimestamp') &&
             isValidNumber('createdAt') &&
             isOptionalRouteGeoJSON(data) &&
             isValidOptionalString('province', 50) &&
             isValidOptionalString('municipality', 50) &&
             isValidOptionalString('description', 500) &&
             (!('isRecording' in data) || data.isRecording is bool) &&
             isValidOptionalNumber('startTime') &&
             isValidRouteListing(data) &&
             isValidOptionalBool('ridePaused') &&
             isValidOptionalNumber('ridePauseStartedAt') &&
             (!('pausedTimeMs' in data) || (data.pausedTimeMs is number && data.pausedTimeMs >= 0 && data.pausedTimeMs <= 864000000));
    }

    function isValidLocation(data) {
      return hasRequiredFields(['uid', 'lat', 'lng', 'timestamp']) &&
             data.uid == request.auth.uid &&
             isValidNumber('lat') &&
             isValidNumber('lng') &&
             isValidNumber('timestamp') &&
             isValidOptionalNumber('speed') &&
             isValidOptionalNumber('heading') &&
             isValidOptionalNumber('score') &&
             isValidOptionalString('photoURL', 200000) &&
             isValidOptionalString('displayName', 50) &&
             (!('alert' in data) || data.alert is map);
    }

    function isValidRideHistory(data) {
      return hasRequiredFields(['uid', 'groupId', 'startTime', 'endTime', 'distance']) &&
             data.uid == request.auth.uid &&
             isValidNumber('startTime') &&
             isValidNumber('endTime') &&
             isValidNumber('distance') &&
             request.resource.data.distance >= 0 &&
             isValidOptionalNumber('maxLeanLeft') &&
             isValidOptionalNumber('maxLeanRight') &&
             isValidOptionalNumber('leftTurns') &&
             isValidOptionalNumber('rightTurns') &&
             isValidOptionalNumber('score') &&
             isValidOptionalNumber('baseScore') &&
             isValidOptionalNumber('pointsEarned') &&
             (!('path' in data) || data.path is list) &&
             isValidOptionalNumber('foodExpenseEuros') &&
             isValidOptionalNumber('splitPerPersonEuros') &&
             isValidOptionalNumber('memberCountForSplit') &&
             isValidOptionalNumber('durationMs') &&
             isValidOptionalString('rideSessionKey', 200) &&
             (!('routeGeoJSON' in data) ||
               (data.routeGeoJSON is string && data.routeGeoJSON.size() <= 1000000));
    }

    // --- Amistad (escrituras en el documento de otro usuario) ---
    function friendIncomingList(data) {
      return ('friendRequestsIncoming' in data && data.friendRequestsIncoming is list)
        ? data.friendRequestsIncoming
        : [];
    }
    function friendOutgoingList(data) {
      return ('friendRequestsOutgoing' in data && data.friendRequestsOutgoing is list)
        ? data.friendRequestsOutgoing
        : [];
    }
    function friendsList(data) {
      return ('friends' in data && data.friends is list) ? data.friends : [];
    }

    function crossUserAddSelfToTheirIncoming(uId) {
      return request.auth.uid != uId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendRequestsIncoming']) &&
        request.resource.data.friendRequestsIncoming is list &&
        friendIncomingList(request.resource.data).size() <= friendIncomingList(resource.data).size() + 1 &&
        request.auth.uid in friendIncomingList(request.resource.data);
    }
    function crossUserRemoveSelfFromTheirIncoming(uId) {
      return request.auth.uid != uId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendRequestsIncoming']) &&
        request.resource.data.friendRequestsIncoming is list &&
        request.auth.uid in friendIncomingList(resource.data) &&
        !(request.auth.uid in friendIncomingList(request.resource.data));
    }
    function crossUserRemoveSelfFromTheirOutgoing(uId) {
      return request.auth.uid != uId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendRequestsOutgoing']) &&
        request.resource.data.friendRequestsOutgoing is list &&
        request.auth.uid in friendOutgoingList(resource.data) &&
        !(request.auth.uid in friendOutgoingList(request.resource.data));
    }
    function crossUserAcceptFriendOnRequester(uId) {
      return request.auth.uid != uId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendRequestsOutgoing', 'friends']) &&
        request.resource.data.friendRequestsOutgoing is list &&
        request.resource.data.friends is list &&
        request.auth.uid in friendsList(request.resource.data) &&
        !(request.auth.uid in friendOutgoingList(request.resource.data)) &&
        request.auth.uid in friendOutgoingList(resource.data);
    }
    function crossUserRemoveSelfFromTheirFriends(uId) {
      return request.auth.uid != uId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']) &&
        request.resource.data.friends is list &&
        request.auth.uid in friendsList(resource.data) &&
        !(request.auth.uid in friendsList(request.resource.data));
    }

    /** Invitación a ruta: amistad (lista en uno u otro) o ambos ya miembros del mismo grupo. */
    function inviteCoMembersOnGroup(groupId, otherUid) {
      return groupId is string && groupId.size() == 6 && otherUid is string &&
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.members is list &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members &&
        otherUid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    /** Quien ya es miembro del grupo puede invitar a otros a ese código (la UI solo lista amigos). */
    function inviterMemberOfGroup(gid) {
      return gid is string && gid.size() == 6 &&
        exists(/databases/$(database)/documents/groups/$(gid)) &&
        get(/databases/$(database)/documents/groups/$(gid)).data.members is list &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
    }

    function directChatIdMatchesMembers(chatId, members) {
      return members is list && members.size() == 2 &&
        members[0] is string && members[1] is string &&
        (
          (members[0] < members[1] && chatId == members[0] + '_' + members[1]) ||
          (members[0] > members[1] && chatId == members[1] + '_' + members[0])
        );
    }

    function usersAreFriends(uidA, uidB) {
      return uidA is string && uidB is string &&
        exists(/databases/$(database)/documents/users/$(uidA)) &&
        exists(/databases/$(database)/documents/users/$(uidB)) &&
        (
          uidB in friendsList(get(/databases/$(database)/documents/users/$(uidA)).data) ||
          uidA in friendsList(get(/databases/$(database)/documents/users/$(uidB)).data)
        );
    }

    /**
     * DM ya existente (mismo id que `lib/directChatId.ts`: uid menor_uid mayor).
     * El chat de mensajes no revalida `friends` en cada envío; si las listas fallan,
     * igual pueden chatear — permitimos invitar en ese caso (sala con ambos en members).
     */
    function hasDmRoomBetween(uidA, uidB) {
      return uidA is string && uidB is string && uidA != uidB &&
        (
          (uidA < uidB &&
            exists(/databases/$(database)/documents/privateChats/$(uidA + '_' + uidB)) &&
            get(/databases/$(database)/documents/privateChats/$(uidA + '_' + uidB)).data.members is list &&
            uidA in get(/databases/$(database)/documents/privateChats/$(uidA + '_' + uidB)).data.members &&
            uidB in get(/databases/$(database)/documents/privateChats/$(uidA + '_' + uidB)).data.members) ||
          (uidA > uidB &&
            exists(/databases/$(database)/documents/privateChats/$(uidB + '_' + uidA)) &&
            get(/databases/$(database)/documents/privateChats/$(uidB + '_' + uidA)).data.members is list &&
            uidA in get(/databases/$(database)/documents/privateChats/$(uidB + '_' + uidA)).data.members &&
            uidB in get(/databases/$(database)/documents/privateChats/$(uidB + '_' + uidA)).data.members)
        );
    }

    /**
     * Solicitud de amistad pendiente (listas que la app mantiene con arrayUnion de uids).
     * Cubre casos donde aún no hay entrada mutua en `friends` pero sí vínculo en solicitudes.
     */
    function pendingFriendshipAllowsInvite(uidA, uidB) {
      return uidA is string && uidB is string &&
        exists(/databases/$(database)/documents/users/$(uidA)) &&
        exists(/databases/$(database)/documents/users/$(uidB)) &&
        (
          uidB in friendIncomingList(get(/databases/$(database)/documents/users/$(uidA)).data) ||
          uidA in friendIncomingList(get(/databases/$(database)/documents/users/$(uidB)).data) ||
          uidB in friendOutgoingList(get(/databases/$(database)/documents/users/$(uidA)).data) ||
          uidA in friendOutgoingList(get(/databases/$(database)/documents/users/$(uidB)).data)
        );
    }

    function rideInviteSocialOk(inviterUid, receiverUid, groupId) {
      return usersAreFriends(inviterUid, receiverUid) ||
        hasDmRoomBetween(inviterUid, receiverUid) ||
        pendingFriendshipAllowsInvite(inviterUid, receiverUid) ||
        inviteCoMembersOnGroup(groupId, receiverUid) ||
        inviterMemberOfGroup(groupId);
    }

    function crossUserRideInviteForbiddenTopLevel() {
      return [
        'friends', 'friendRequestsIncoming', 'friendRequestsOutgoing',
        'displayName', 'displayNameLower', 'photoURL', 'isPremium', 'points', 'level',
        'totalDistance', 'totalLeftTurns', 'totalRightTurns', 'motorcycle', 'email', 'uid'
      ].toSet();
    }

    /**
     * Escritura cruzada rideInvitePending: bloquear toques reales a campos sensibles.
     * Usar changed/added/removed en lugar de affectedKeys(): en algunos docs, affectedKeys
     * incluye claves por normalización de tipos (p. ej. number) aunque el cliente solo envíe
     * rideInvitePending — y entonces choca con la denylist (points, level, …).
     */
    function crossUserRideInviteUserDiffOk() {
      let d = request.resource.data.diff(resource.data);
      let forbid = crossUserRideInviteForbiddenTopLevel();
      return !d.changedKeys().hasAny(forbid) &&
        !d.addedKeys().hasAny(forbid) &&
        !d.removedKeys().hasAny(forbid);
    }

    function crossUserSetRideInviteOnFriend(friendId) {
      return request.auth.uid != friendId &&
        crossUserRideInviteUserDiffOk() &&
        request.resource.data.rideInvitePending is map &&
        request.resource.data.rideInvitePending.fromUid == request.auth.uid &&
        request.resource.data.rideInvitePending.groupId is string &&
        request.resource.data.rideInvitePending.groupId.size() == 6 &&
        request.resource.data.rideInvitePending.groupName is string &&
        request.resource.data.rideInvitePending.groupName.size() <= 120 &&
        validRideInviteSentAt(request.resource.data.rideInvitePending.sentAt) &&
        rideInviteSocialOk(request.auth.uid, friendId, request.resource.data.rideInvitePending.groupId);
    }

    function isValidRideInviteDoc(data) {
      return data.keys().hasAll(['fromUid', 'groupId', 'groupName', 'sentAt']) &&
        data.fromUid is string &&
        data.groupId is string && data.groupId.size() == 6 &&
        data.groupName is string && data.groupName.size() <= 120 &&
        validRideInviteSentAt(data.sentAt) &&
        (!('kind' in data) || (data.kind is string && data.kind.size() <= 32));
    }

    function crossUserWriteInviteDoc(receiverUid) {
      let gid = request.resource.data.groupId;
      return request.auth.uid != receiverUid &&
        rideInviteSocialOk(request.auth.uid, receiverUid, gid);
    }

    function isGroupMember(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)) &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.members is list &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) &&
        (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false);
      allow update: if isAuthenticated() && (
        (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPremium']) &&
          request.resource.data.isPremium is bool) ||
        (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'level']) &&
          isValidUser(request.resource.data) &&
          request.resource.data.points is number &&
          request.resource.data.level is number &&
          request.resource.data.points >= 0 &&
          request.resource.data.points <= 2000000000 &&
          request.resource.data.level >= 1 &&
          request.resource.data.level <= 1000000) ||
        (isOwner(userId) && isValidUser(request.resource.data) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium'])) ||
        crossUserAddSelfToTheirIncoming(userId) ||
        crossUserRemoveSelfFromTheirIncoming(userId) ||
        crossUserRemoveSelfFromTheirOutgoing(userId) ||
        crossUserAcceptFriendOnRequester(userId) ||
        crossUserRemoveSelfFromTheirFriends(userId) ||
        crossUserSetRideInviteOnFriend(userId)
      );

      match /invites/{inviteId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow create: if isAuthenticated() &&
          crossUserWriteInviteDoc(userId) &&
          request.resource.data.fromUid == request.auth.uid &&
          isValidRideInviteDoc(request.resource.data);
        allow update: if isAuthenticated() &&
          crossUserWriteInviteDoc(userId) &&
          resource.data.fromUid == request.auth.uid &&
          request.resource.data.fromUid == request.auth.uid &&
          isValidRideInviteDoc(request.resource.data);
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }

      /** Rechazo definitivo desde buzón: el invitador no puede reenviar para esa ruta. */
      match /inviteRejections/{rejId} {
        function inviteRejectionIdMatches(data) {
          return data.inviterUid is string &&
            data.inviterUid.size() > 4 &&
            data.groupId is string &&
            data.groupId.size() == 6 &&
            rejId == data.inviterUid + '_' + data.groupId;
        }
        allow read: if isAuthenticated() && (
          request.auth.uid == userId ||
          (
            exists(/databases/$(database)/documents/users/$(userId)/inviteRejections/$(rejId)) &&
            get(/databases/$(database)/documents/users/$(userId)/inviteRejections/$(rejId)).data.inviterUid == request.auth.uid
          )
        );
        allow create: if isOwner(userId) &&
          request.resource.data.keys().hasAll(['inviterUid', 'groupId', 'rejectedAt']) &&
          request.resource.data.rejectedAt is number &&
          request.resource.data.rejectedAt > request.time.toMillis() - 86400000 &&
          request.resource.data.rejectedAt < request.time.toMillis() + 86400000 &&
          inviteRejectionIdMatches(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /fcmTokens/{tokenId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasAll(['token', 'createdAt']) &&
          request.resource.data.token is string &&
          request.resource.data.token.size() >= 80 &&
          request.resource.data.token.size() <= 2048 &&
          request.resource.data.createdAt is number &&
          request.resource.data.createdAt > request.time.toMillis() - 86400000 &&
          request.resource.data.createdAt < request.time.toMillis() + 86400000 &&
          (!('ua' in request.resource.data) ||
            (request.resource.data.ua is string && request.resource.data.ua.size() <= 300));
        allow delete: if isOwner(userId);
      }

      /** Último mensaje visto en chat plan (grupo) o DM (amigo); solo el propietario. */
      match /readReceipts/{rid} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasOnly(['lastReadAt']) &&
          request.resource.data.lastReadAt is number &&
          request.resource.data.lastReadAt > request.time.toMillis() - 86400000 &&
          request.resource.data.lastReadAt < request.time.toMillis() + 86400000;
      }
    }

    match /privateChats/{chatId} {
      allow read: if isAuthenticated() &&
        resource.data.members is list &&
        request.auth.uid in resource.data.members &&
        usersAreFriends(resource.data.members[0], resource.data.members[1]);
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasAll(['members', 'updatedAt']) &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 2 &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.updatedAt is number &&
        request.resource.data.updatedAt > request.time.toMillis() - 86400000 &&
        request.resource.data.updatedAt < request.time.toMillis() + 86400000 &&
        directChatIdMatchesMembers(chatId, request.resource.data.members) &&
        request.resource.data.keys().hasOnly(['members', 'updatedAt']) &&
        usersAreFriends(request.resource.data.members[0], request.resource.data.members[1]);
      allow update: if isAuthenticated() &&
        resource.data.members is list &&
        request.auth.uid in resource.data.members &&
        usersAreFriends(resource.data.members[0], resource.data.members[1]) &&
        request.resource.data.members == resource.data.members &&
        request.resource.data.updatedAt is number &&
        request.resource.data.updatedAt > request.time.toMillis() - 86400000 &&
        request.resource.data.updatedAt < request.time.toMillis() + 86400000 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']);
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isAuthenticated() &&
          get(/databases/$(database)/documents/privateChats/$(chatId)).data.members is list &&
          request.auth.uid in get(/databases/$(database)/documents/privateChats/$(chatId)).data.members;
        allow create: if isAuthenticated() &&
          get(/databases/$(database)/documents/privateChats/$(chatId)).data.members is list &&
          request.auth.uid in get(/databases/$(database)/documents/privateChats/$(chatId)).data.members &&
          request.resource.data.keys().hasAll(['text', 'uid', 'displayName', 'createdAt']) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() > 0 &&
          request.resource.data.displayName.size() <= 80 &&
          request.resource.data.createdAt is number &&
          request.resource.data.createdAt > request.time.toMillis() - 86400000 &&
          request.resource.data.createdAt < request.time.toMillis() + 86400000;
        allow update, delete: if false;
      }
    }

    match /premiumCandidates/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated()
        && request.auth.uid == docId
        && request.resource.data.uid == docId
        && request.resource.data.updatedAt is number
        && isValidOptionalString('email', 120)
        && isValidOptionalString('displayName', 80)
        && isValidOptionalString('photoURL', 200000)
        && request.resource.data.source is string
        && request.resource.data.source.size() >= 1
        && request.resource.data.source.size() <= 80
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'updatedAt', 'source']);
      allow delete: if isAdmin();
    }

    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidGroup(request.resource.data);
      allow update: if isAuthenticated() && (
        (resource.data.createdBy == request.auth.uid && isValidGroup(request.resource.data) &&
          (!('isScheduled' in resource.data && resource.data.isScheduled == true) ||
           request.auth.uid in request.resource.data.members)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
         request.resource.data.members.size() > resource.data.members.size() &&
         request.resource.data.members.hasAll(resource.data.members) &&
         request.auth.uid in request.resource.data.members) ||
        // Invitado se sale: solo quita su uid de members (ruta en vivo o programada; antes solo permitía isScheduled==true).
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
         request.resource.data.members.size() == resource.data.members.size() - 1 &&
         request.auth.uid in resource.data.members &&
         !(request.auth.uid in request.resource.data.members) &&
         resource.data.createdBy != request.auth.uid)
      );
      allow delete: if (isAuthenticated() && resource.data.createdBy == request.auth.uid) || isAdmin();

      match /planMessages/{msgId} {
        allow read: if isAuthenticated() && isGroupMember(groupId);
        allow create: if isAuthenticated() && isGroupMember(groupId) &&
          request.resource.data.keys().hasAll(['text', 'uid', 'displayName', 'createdAt']) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 800 &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() > 0 &&
          request.resource.data.displayName.size() <= 80 &&
          request.resource.data.createdAt is number &&
          request.resource.data.createdAt > request.time.toMillis() - 86400000 &&
          request.resource.data.createdAt < request.time.toMillis() + 86400000;
        allow update, delete: if false;
      }
    }

    match /locations/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidLocation(request.resource.data);
      allow update: if isOwner(userId) && isValidLocation(request.resource.data);
    }

    match /rideHistory/{rideId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(resource.data.uid)) &&
         'friends' in get(/databases/$(database)/documents/users/$(resource.data.uid)).data &&
         request.auth.uid in get(/databases/$(database)/documents/users/$(resource.data.uid)).data.friends)
      );
      allow create: if isAuthenticated() && isValidRideHistory(request.resource.data);
      allow update: if isAuthenticated() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        isValidRideHistory(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /appConfig/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /pointsEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
  }
}
