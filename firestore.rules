rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == "juarp123@gmail.com";
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidString(field, min, max) {
      return request.resource.data[field] is string &&
             request.resource.data[field].size() >= min &&
             request.resource.data[field].size() <= max;
    }

    function isValidOptionalString(field, max) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    function isValidNumber(field) {
      return request.resource.data[field] is number;
    }

    function isValidOptionalNumber(field) {
      return !(field in request.resource.data) || request.resource.data[field] is number;
    }

    function isValidOptionalBool(field) {
      return !(field in request.resource.data) || request.resource.data[field] is bool;
    }

    function isValidUser(data) {
      return hasRequiredFields(['displayName']) &&
             isValidString('displayName', 1, 50) &&
             isValidOptionalString('displayNameLower', 50) &&
             isValidOptionalString('photoURL', 200000) &&
             isValidOptionalNumber('points') &&
             isValidOptionalNumber('level') &&
             isValidOptionalNumber('totalDistance') &&
             isValidOptionalNumber('totalLeftTurns') &&
             isValidOptionalNumber('totalRightTurns') &&
             (!('friends' in data) || data.friends is list) &&
             (!('friendRequestsIncoming' in data) || data.friendRequestsIncoming is list) &&
             (!('friendRequestsOutgoing' in data) || data.friendRequestsOutgoing is list) &&
             isValidOptionalBool('isPremium');
    }

    function isOptionalRouteGeoJSON(data) {
      return !('routeGeoJSON' in data) ||
             data.routeGeoJSON == null ||
             (data.routeGeoJSON is string && data.routeGeoJSON.size() <= 1000000);
    }

    function isValidGroup(data) {
      return hasRequiredFields(['name', 'code', 'createdBy', 'members', 'isScheduled', 'scheduledTimestamp', 'createdAt']) &&
             isValidString('name', 1, 100) &&
             isValidString('code', 6, 6) &&
             data.createdBy == request.auth.uid &&
             data.members is list &&
             data.members.size() <= 100 &&
             isValidNumber('scheduledTimestamp') &&
             isValidNumber('createdAt') &&
             isOptionalRouteGeoJSON(data) &&
             isValidOptionalString('province', 50) &&
             isValidOptionalString('municipality', 50) &&
             isValidOptionalString('description', 500) &&
             (!('isRecording' in data) || data.isRecording is bool) &&
             isValidOptionalNumber('startTime');
    }

    function isValidLocation(data) {
      return hasRequiredFields(['uid', 'lat', 'lng', 'timestamp']) &&
             data.uid == request.auth.uid &&
             isValidNumber('lat') &&
             isValidNumber('lng') &&
             isValidNumber('timestamp') &&
             isValidOptionalNumber('speed') &&
             isValidOptionalNumber('heading') &&
             isValidOptionalNumber('score') &&
             isValidOptionalString('photoURL', 200000) &&
             isValidOptionalString('displayName', 50) &&
             (!('alert' in data) || data.alert is map);
    }

    function isValidRideHistory(data) {
      return hasRequiredFields(['uid', 'groupId', 'startTime', 'endTime', 'distance']) &&
             data.uid == request.auth.uid &&
             isValidNumber('startTime') &&
             isValidNumber('endTime') &&
             isValidNumber('distance') &&
             request.resource.data.distance >= 0 &&
             isValidOptionalNumber('maxLeanLeft') &&
             isValidOptionalNumber('maxLeanRight') &&
             isValidOptionalNumber('leftTurns') &&
             isValidOptionalNumber('rightTurns') &&
             isValidOptionalNumber('score') &&
             (!('path' in data) || data.path is list);
    }

    // --- Amistad (escrituras en el documento de otro usuario) ---
    function friendIncomingList(data) {
      return ('friendRequestsIncoming' in data && data.friendRequestsIncoming is list)
        ? data.friendRequestsIncoming
        : [];
    }
    function friendOutgoingList(data) {
      return ('friendRequestsOutgoing' in data && data.friendRequestsOutgoing is list)
        ? data.friendRequestsOutgoing
        : [];
    }
    function friendsList(data) {
      return ('friends' in data && data.friends is list) ? data.friends : [];
    }

    function crossUserAddSelfToTheirIncoming(uId) {
      return request.auth.uid != uId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendRequestsIncoming']) &&
        request.resource.data.friendRequestsIncoming is list &&
        friendIncomingList(request.resource.data).size() <= friendIncomingList(resource.data).size() + 1 &&
        request.auth.uid in friendIncomingList(request.resource.data);
    }
    function crossUserRemoveSelfFromTheirIncoming(uId) {
      return request.auth.uid != uId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendRequestsIncoming']) &&
        request.resource.data.friendRequestsIncoming is list &&
        request.auth.uid in friendIncomingList(resource.data) &&
        !(request.auth.uid in friendIncomingList(request.resource.data));
    }
    function crossUserRemoveSelfFromTheirOutgoing(uId) {
      return request.auth.uid != uId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendRequestsOutgoing']) &&
        request.resource.data.friendRequestsOutgoing is list &&
        request.auth.uid in friendOutgoingList(resource.data) &&
        !(request.auth.uid in friendOutgoingList(request.resource.data));
    }
    function crossUserAcceptFriendOnRequester(uId) {
      return request.auth.uid != uId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendRequestsOutgoing', 'friends']) &&
        request.resource.data.friendRequestsOutgoing is list &&
        request.resource.data.friends is list &&
        request.auth.uid in friendsList(request.resource.data) &&
        !(request.auth.uid in friendOutgoingList(request.resource.data)) &&
        request.auth.uid in friendOutgoingList(resource.data);
    }
    function crossUserRemoveSelfFromTheirFriends(uId) {
      return request.auth.uid != uId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']) &&
        request.resource.data.friends is list &&
        request.auth.uid in friendsList(resource.data) &&
        !(request.auth.uid in friendsList(request.resource.data));
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) &&
        (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false);
      allow update: if isAuthenticated() && (
        (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPremium']) &&
          request.resource.data.isPremium is bool) ||
        (isOwner(userId) && isValidUser(request.resource.data) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium'])) ||
        crossUserAddSelfToTheirIncoming(userId) ||
        crossUserRemoveSelfFromTheirIncoming(userId) ||
        crossUserRemoveSelfFromTheirOutgoing(userId) ||
        crossUserAcceptFriendOnRequester(userId) ||
        crossUserRemoveSelfFromTheirFriends(userId)
      );
    }

    match /premiumCandidates/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated()
        && request.auth.uid == docId
        && request.resource.data.uid == docId
        && request.resource.data.updatedAt is number
        && isValidOptionalString('email', 120)
        && isValidOptionalString('displayName', 80)
        && isValidOptionalString('photoURL', 200000)
        && request.resource.data.source is string
        && request.resource.data.source.size() >= 1
        && request.resource.data.source.size() <= 80
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'updatedAt', 'source']);
      allow delete: if isAdmin();
    }

    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidGroup(request.resource.data);
      allow update: if isAuthenticated() && (
        (resource.data.createdBy == request.auth.uid && isValidGroup(request.resource.data) &&
          (!('isScheduled' in resource.data && resource.data.isScheduled == true) ||
           request.auth.uid in request.resource.data.members)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
         request.resource.data.members.size() > resource.data.members.size() &&
         request.resource.data.members.hasAll(resource.data.members) &&
         request.auth.uid in request.resource.data.members) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
         'isScheduled' in resource.data && resource.data.isScheduled == true &&
         request.resource.data.members.size() == resource.data.members.size() - 1 &&
         request.auth.uid in resource.data.members &&
         !(request.auth.uid in request.resource.data.members) &&
         resource.data.createdBy != request.auth.uid)
      );
      allow delete: if (isAuthenticated() && resource.data.createdBy == request.auth.uid) || isAdmin();
    }

    match /locations/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidLocation(request.resource.data);
      allow update: if isOwner(userId) && isValidLocation(request.resource.data);
    }

    match /rideHistory/{rideId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(resource.data.uid)) &&
         'friends' in get(/databases/$(database)/documents/users/$(resource.data.uid)).data &&
         request.auth.uid in get(/databases/$(database)/documents/users/$(resource.data.uid)).data.friends)
      );
      allow create: if isAuthenticated() && isValidRideHistory(request.resource.data);
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /appConfig/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /pointsEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
  }
}
