# Cloudflare Pages: evita servir index.html viejo desde la CDN tras un deploy
# (HTML apuntando a /assets/*.js que ya no existen => pantalla en blanco).
# Tras desplegar, purga caché en Cloudflare si el problema ya afectó a usuarios.

/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Cabeceras de seguridad para todas las rutas (CSP: scripts solo del propio origen; apis.google.com y
# dominios de Firebase Auth para el inicio de sesión con Google; resto de orígenes de datos vía connect-src/img-src).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://apis.google.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; worker-src 'self' blob:; frame-src https://*.firebaseapp.com https://accounts.google.com https://*.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Hashes en nombre: seguros de cachear largo en navegador/edge
# CORS explícito por si el navegador trata el módulo como petición CORS (p. ej. con crossorigin en HTML antiguo en caché).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
